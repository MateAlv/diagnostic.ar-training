.venv
__pycache__/
*.egg-info/
.pytest_cache/
.ruff_cache/

# Raw sources are fetched and sha256-verified from data/sources.yaml; never committed.
data/raw
# Derived artifacts are rebuilt from manifests or published as release assets.
data/interim
data/processed/
runs/
# Phase 3 results rows (small JSON, committed by the main session).
!results/P3/runs/
results/**/*.npz
results/**/*.pt
results/**/*.onnx
*.ckpt

# Agent worktrees are created inside the checkout; never commit them.
.claude/worktrees/
